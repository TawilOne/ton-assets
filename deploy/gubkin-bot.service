[Unit]
Description=Gubkin schedule Telegram bot
After=network-online.target gubkin-proxy.service
Wants=network-online.target gubkin-proxy.service

[Service]
User=gubkin
WorkingDirectory=/opt/gubkin-bot/gubkin_schedule_bot
# всё через локальный прокси (sing-box): Telegram — через VPN-ключ, а сайт Губкина —
# через тот путь (напрямую или один из ключей подписки), где он открывается: хостинги он не пускает
Environment=TG_PROXY=http://127.0.0.1:1080
Environment=GUBKIN_PROXY_ALWAYS=http://127.0.0.1:1080
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/gubkin-bot/venv/bin/python bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
